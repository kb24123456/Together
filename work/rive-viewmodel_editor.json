          "modifyDataBind": {
            "type": "object",
            "properties": {
              "objectId": {
                "description": "ID of the object whose existing bind to modify",
                "type": "string"
              },
              "propertyKey": {
                "description": "Property key on the object whose bind to modify",
                "type": "integer"
              },
              "direction": {
                "description": "Optional. Sets the primary direction bit independently of twoWay. toTarget = ViewModel -> Object (the default for a new bind); toSource = Object -> ViewModel. When twoWay is also true, this still determines which side the converter treats as input vs output.",
                "type": "string",
                "enum": [
                  "toTarget",
                  "toSource"
                ]
              },
              "twoWay": {
                "description": "Optional. Enable bidirectional sync. Independent of direction \u2014 leave direction unset to preserve the existing primary direction.",
                "type": "boolean"
              },
              "once": {
                "description": "Optional. If true, the bind is applied only once.",
                "type": "boolean"
              },
              "sourceToTargetRunsFirst": {
                "description": "Optional. For two-way binds, when true source-to-target runs before target-to-source.",
                "type": "boolean"
              },
              "converterId": {
                "description": "Optional. ID of a DataConverter to attach. Pass empty string to remove an existing converter.",
                "type": "string"
              },
              "path": {
                "description": "Optional. Retargets the bind's source path to a different route to the same property. Segment names joined with \" -> \", exactly as errors and listDataBinds list them.",
                "type": "string"
              },
              "isRelative": {
                "description": "Optional. Sets or clears the relative flag (the relative toggle in the bind popup): a relative bind resolves its source by property names from whatever instance is bound at runtime instead of fixed ids.",
                "type": "boolean"
              }
            },
