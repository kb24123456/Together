                                ]
                              },
                              {
                                "required": [
                                  "enumId"
                                ]
                              }
                            ]
                          },
                          {
                            "type": "object",
                            "properties": {
                              "name": {
                                "type": "string"
                              },
                              "viewModelId": {
                                "description": "Id of the referenced view model. Preferred over viewModelName: names are not unique, and listViewModels emits both so its output feeds straight back in.",
                                "type": "string"
                              },
                              "viewModelName": {
                                "description": "Name of the referenced view model. Resolves against view models created in this same call first, then existing ones. Ignored when viewModelId is given.",
                                "type": "string"
                              },
                              "propertyType": {
                                "const": "viewModel"
                              }
                            },
                            "required": [
                              "name"
