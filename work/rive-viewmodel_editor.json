                              "propertyType": {
                                "const": "list"
                              }
                            }
                          },
                          {
                            "description": "Exposes an item's position in the list that holds it. One per viewmodel; always named \"index\" (the name field is ignored). Read-only: bind or condition on it, and write it into a number property via a create_listeners viewModelChange sourceViewModelPropertyId.",
                            "type": "object",
