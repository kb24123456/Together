            "type": "object",
            "properties": {
              "componentIds": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1,
                "description": "The IDs of the component placements to set the data context on. All must live in the same parent artboard."
              },
              "componentId": {
                "type": "string",
                "description": "Deprecated: a single placement id. Prefer componentIds."
              },
              "viewModelPropertyName": {
                "type": "string",
                "description": "The name of the viewmodel property (of type viewModel) that supplies the data context. If no property with this name exists, one is created on the parent artboard's viewmodel (which must be bound first)."
              },
              "inherit": {
                "const": true,
                "description": "Pass true to clear the data context so the placement inherits from its parent artboard (the Inherit option in the inspector). Mutually exclusive with viewModelPropertyName."
              },
              "path": {
                "type": "string",
                "description": "Optional: disambiguates when several paths reach the property. Segment names joined with \" -> \" (the root viewmodel, then the viewmodel-property name of each hop), exactly as errors and query results list them."
              },
              "viewModelInstanceName": {
                "type": "string",
                "description": "Optional: assigns this instance of the component's viewmodel to the property. Created if no instance with this name exists. When omitted the property's current instance is kept."
              }
            },
