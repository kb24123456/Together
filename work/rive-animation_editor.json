          "createStates",
          "updateStates",
          "createTransitions",
          "createConditions",
          "updateConditions",
          "deleteConditions",
          "renameAnimations",
          "modifyKeyFrames",
          "queryKeyFrames",
          "reverseKeyFrames",
          "simulateStateMachine"
        ]
      },
      "data": {
        "type": "object",
        "properties": {
          "createStateMachine": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "layers": {
                "type": "array",
